{
  "name": "@wisent-ai/glina",
  "version": "1.0.0",
  "description": "Glina — your AI sculpts your game assets. Procedural THREE.js runtime art plus an AI text-to-3D pipeline (Brama-modeled Blender sculpting, Weles browser layer, Skarbiec-only credentials) with a GLB quality gate.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./anatomy": "./src/anatomy.js",
    "./sculpt": "./src/sculpt.js",
    "./sculpt-gear": "./src/sculpt-gear.js",
    "./card-art": "./src/card-art.js",
    "./loader": "./src/loader.js"
  },
  "files": [
    "src",
    "assets",
    "pipeline",
    "pipeline.config.example.json",
    "SKILL.md"
  ],
  "keywords": [
    "threejs",
    "procedural-generation",
    "game-assets",
    "ai",
    "blender",
    "glb"
  ],
  "license": "MIT",
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "scripts": {
    "test": "node --test 'tests/*.test.mjs'",
    "setup": "node pipeline/setup.js"
  },
  "bin": {
    "glina": "pipeline/cli.js",
    "glina-mcp": "pipeline/mcp.js"
  }
}
