{
  "schema_version": 1,
  "product": "glina",
  "releases": true,
  "version_source": {
    "kind": "json",
    "path": "package.json",
    "pointer": "/version"
  },
  "platforms": {
    "npm-package": {
      "runner_platform": "linux-amd64",
      "quality": [
        {
          "name": "version-gate",
          "argv": [
            "stado", "release", "version-gate", "app-check",
            "--package-json", "package.json", "--export-conditions", "import,node,default", "--js-exports",
            "--command-array", "pipeline/arguments.js:COMMANDS", "--mcp-tools", "pipeline/mcp.js"
          ]
        }
      ],
      "build": {
        "argv": ["stado", "product", "npm", "pack"]
      },
      "tests": [
        {"name": "product-tests", "argv": ["node", "--test"]}
      ],
      "stage": {
        "release/npm-package.tgz": "npm-package.tgz",
        "release/npm-package.tgz.sha256": "npm-package.tgz.sha256"
      }
    }
  },
  "promotion": {
    "channels": ["candidate", "stable"],
    "reconcile": false
  },
  "deliveries": [
    {
      "name": "npm",
      "platform": "npm-package",
      "argv": ["stado", "product", "deliver", "npm"],
      "required": true,
      "secret_env": {
        "NPM_TOKEN": "npm#token"
      }
    }
  ]
}
