{
  "browser": {
    "engine": "chromium",
    "headless": true
  },
  "credentials": {
    "username": "role://text2game-account/login_email",
    "password": "role://text2game-account/login_password"
  },
  "studio": {
    "loginUrl": "https://hunyuan3d.tencent.com/login",
    "generateUrl": "https://hunyuan3d.tencent.com/studio",
    "selectors": {
      "loginUser": "input[type=email]",
      "loginPassword": "input[type=password]",
      "loginSubmit": "button[type=submit]",
      "promptInput": "textarea",
      "generateSubmit": "button.generate"
    },
    "artifact": {
      "expression": "document.querySelector('a.download-glb')?.href ?? null"
    }
  },
  "models": {
    "brama": {
      "key": "role://glina-agent-auth/agent_auth_secret",
      "bearer": "role://glina-model-router/token",
      "model": "any",
      "_comment": "Brama (org model router). Its address comes from Stado's service directory; set url only to override it. Without Brama replace models.brama with models.openai_compatible: url, bearer and model of any OpenAI-compatible provider.",
      "agent_id": "role://glina-agent-auth/id"
    }
  },
  "llm": {
    "maxRounds": 12
  },
  "verify": {
    "enabled": true,
    "triTarget": 6000,
    "triTolerancePct": 100
  },
  "blender": {
    "enabled": false,
    "mcp": {}
  }
}
